{
  "name": "dolly",
  "productName": "Dolly",
  "version": "0.1.0",
  "description": "A screen recorder that zooms in on every click and smooths your cursor.",
  "author": "Dolly contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:native": "node native/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist:mac": "npm run build:native && npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build:native && npm run build && electron-builder --win --publish never",
    "make:icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "electron-builder": "26.17.0",
    "electron-vite": "6.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  }
}
